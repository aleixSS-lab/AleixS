---
// Creamos una dependencia de un link, osea que cuando se use este componente,
// se le pasara un link de github y se abrira en otra pestaña.
interface Props {
  href: string; //Tipo string
}

const { href } = Astro.props; // Astro.props es un objeto que contiene las propiedades que se le pasan al componente.
// En este caso, se le pasa un href.
---

<a class="discord-link" href={href} target="_blank" rel="noopener noreferrer">
  <!--href= {href}  =  el href es el que pasaremos despues  -->
  <svg class="social-icon" viewBox="0 0 24 24" fill="currentColor">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path
        d="M12 .3a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.05c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.74.08-.74 1.2.08 1.84 1.23 1.84 1.23 1.07 1.84 2.8 1.31 3.49 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.34-5.47-5.93 0-1.31.47-2.38 1.23-3.22-.12-.3-.53-1.52.12-3.17 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.3-1.55 3.3-1.23 3.3-1.23.65 1.65.24 2.87.12 3.17.77.84 1.23 1.91 1.23 3.22 0 4.6-2.8 5.62-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.69.83.57A12 12 0 0 0 12 .3Z"
      ></path>
    </svg>
  </svg>

  <span>Discord</span>
</a>

<style>
  .discord-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;

    padding: 10px 16px;

    color: #b8b8c2;
    background: rgba(255, 255, 255, 0.04);

    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;

    text-decoration: none;
    font-size: 14px;
    font-weight: 500;

    transition:
      background 0.3s ease,
      color 0.3s ease,
      border-color 0.3s ease,
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .discord-link .social-icon {
    width: 20px;
    height: 20px;
    display: block;

    transition:
      transform 0.3s ease,
      color 0.3s ease;
  }

  .discord-link:hover {
    color: #ffffff;

    background: rgba(88, 101, 242, 0.15);
    border-color: rgba(88, 101, 242, 0.5);

    transform: translateY(-2px);

    box-shadow: 0 8px 25px rgba(88, 101, 242, 0.18);
  }

  .discord-link:hover .social-icon {
    color: #5865f2;
    transform: scale(1.1);
  }

  .discord-link:active {
    transform: translateY(0);
  }
</style>
