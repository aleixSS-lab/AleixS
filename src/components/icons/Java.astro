<div id="icon-java-div-icon">
  <img
    id="icon-java"
    src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/java/java-original.svg"
    alt="Java"
  />
  <p>Java</p>
</div>

<style>
  #icon-java-div-icon {
    display: inline-flex;
    align-items: center;
    gap: 10px;

    width: fit-content;
    min-width: 130px;
    height: 42px;

    padding: 6px 14px 6px 8px;
    box-sizing: border-box;
    margin: 5px;

    background: #5f9fff;
    color: #ffffff;

    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;

    box-shadow: 0 6px 20px rgba(54, 198, 246, 0.18);

    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      background-color 0.25s ease;

    cursor: default;
  }

  #icon-java-div-icon:hover {
    transform: translateY(-2px);

    background: #5eaed1;

    box-shadow: 0 10px 28px rgba(108, 208, 235, 0.28);
  }

  #icon-java {
    width: 34px;
    height: 34px;

    object-fit: contain;
    display: block;
  }

  #icon-java-div-icon p {
    margin: 0;

    font-size: 15px;
    font-weight: 600;
    line-height: 1;

    white-space: nowrap;
  }
</style>
