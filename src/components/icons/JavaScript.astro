<div id="icon-javascript-div-icon">
  <img
    id="icon-javascript"
    src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/javascript/javascript-original.svg"
    alt="JavaScript"
  />
  <p>JavaScript</p>
</div>

<style>
  #icon-javascript-div-icon {
    display: inline-flex;
    align-items: center;
    gap: 10px;

    width: fit-content;
    min-width: 130px;
    height: 42px;

    padding: 6px 14px 6px 8px;
    box-sizing: border-box;
    margin: 5px;

    background: #d9e01e93;
    color: #ffffff;

    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;

    box-shadow: 0 6px 20px rgba(253, 240, 2, 0.379);

    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      background-color 0.25s ease;

    cursor: default;
  }

  #icon-javascript-div-icon:hover {
    transform: translateY(-2px);

    background: #e4e456;

    box-shadow: 0 10px 28px rgba(203, 189, 39, 0.87);
  }

  #icon-javascript {
    width: 34px;
    height: 34px;

    object-fit: contain;
    display: block;
  }

  #icon-javascript-div-icon p {
    margin: 0;

    font-size: 15px;
    font-weight: 600;
    line-height: 1;

    white-space: nowrap;
  }
</style>
