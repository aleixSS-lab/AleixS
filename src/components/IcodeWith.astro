---
import Laravel from "./icons/Laravel.astro";
import AstroIcon from "./icons/AstroIcon.astro";
import Flutter from "./icons/Flutter.astro";

import VisualStudio from "./icons/VisualStudio.astro";
import AndroidStudio from "./icons/AndroidStudio.astro";

import Java from "./icons/Java.astro";
import Kotlin from "./icons/Kotlin.astro";
import JavaScript from "./icons/JavaScript.astro";
import Php from "./icons/Php.astro";
import PlSql from "./icons/PlSql.astro";
import Sql from "./icons/Sql.astro";
---

<section id="icodewith">
  <h1 id="icodewith-title">I CODE WITH</h1>
  <hr id="icodewith-divider" />

  <div id="icodewith-content">
    <!-- IDE -->
    <div id="icodewith-divs">
      <h1>IDE</h1>
      <VisualStudio />
      <AndroidStudio />
    </div>

    <!-- FRAMEWORKS -->
    <div id="icodewith-divs">
      <h1>Frameworks</h1>
      <Laravel />
      <AstroIcon />
      <Flutter />
    </div>

    <!-- LANGUAGES -->
    <div id="icodewith-divs">
      <h1>Languages</h1>
      <Java />
      <Kotlin />
      <JavaScript />
      <Php />
      <PlSql />
      <Sql />
    </div>
  </div>
</section>

<style>
  #icodewith {
    padding: 100px 8%;
    background: var(--about-section-background);
  }
  #icodewith-divider {
    width: 50%;
    margin-bottom: 40px;
  }
  #icodewith-title {
    font-size: 50px;
    font-weight: 600;
    margin-bottom: 40px;
    text-align: center;
  }

  #icodewith-content {
    width: 100%;
    height: 98%;
  }

  #icodewith-divs {
    display: inline-block;
    flex-wrap: wrap;
    justify-content: center;
    padding: 20px;
    border: 1px solid var(--about-border);
    border-radius: 30px;
    background-color: var(--about-background);
    width: 27%;
  }

  div + div {
    margin: 20px;
  }
</style>
